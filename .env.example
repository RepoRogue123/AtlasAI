# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional ---------------------------------------------------------------
# Model for acting (default gemini-3.8-flash; if unavailable, the newest Flash model offered by the API is used)
# GEMINI_MODEL=gemini-3.8-flash
# Pricing for the cost meter (USD per 1M tokens)
# PRICE_INPUT_PER_M=0.30
# PRICE_OUTPUT_PER_M=2.50

# Agent budgets
# ATLAS_MAX_STEPS=40
# ATLAS_MAX_VERIFY_STEPS=8
# ATLAS_HEADLESS=1          # set 0 to watch Chromium on your desktop

# Ports
# ATLAS_API_PORT=8000
# SANDBOX_PORT=8001

# Extra secrets for the vault (name = lowercase suffix), e.g. ATLAS_SECRET_CRM_TOKEN=...

# --- Fallback LLM providers (used only when every Gemini model is unavailable) ---
# Groq (free tier): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models): create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pin models. "auto" = pick a tool-capable model (OpenRouter: free models only)
# GROQ_MODEL=auto
# OPENROUTER_MODEL=auto
# GROQ_VISION_MODEL=auto
# OPENROUTER_VISION_MODEL=auto
